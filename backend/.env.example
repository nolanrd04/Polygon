# Copy to backend/.env (gitignored). Only read locally; on Render these are
# set in the service's Environment settings instead.

# Switch databases by uncommenting exactly one block.
# URL and database name always switch together.

# --- LOCAL MONGO (docker compose up -d) ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=polygon_game

# --- CLOUD MONGO (Atlas) ---
# WARNING: if this is the same database Render uses, you are reading and
# writing real player data.
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>
# MONGODB_DATABASE=<database-name>

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Required — the app will fail to start without it. Never reuse this across environments.
SECRET_KEY=

# Comma-separated list of allowed frontend origins (exact match, no trailing slash)
CORS_ORIGINS=http://localhost:3000