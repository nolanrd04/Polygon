# Copy to frontend/.env (gitignored). Only read by the Vite dev server
# (npm run dev); the deployed site routes /api through vercel.json instead.

# Where the dev server forwards /api requests. Leave commented out to use
# the local backend (http://127.0.0.1:8000).
# WARNING: the cloud backend uses the production database.
# API_TARGET=https://<your-render-url>
